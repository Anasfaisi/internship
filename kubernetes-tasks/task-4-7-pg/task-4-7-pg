apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: task-4-7-pg
  namespace: anas-c
  labels:
    task: task-4-7
spec:
  instances: 3
  primaryUpdateStrategy: unsupervised
  enableSuperuserAccess: false
  affinity:
    enablePodAntiAffinity: true
    topologyKey: kubernetes.io/hostname
    podAntiAffinityType: required
  bootstrap:
    initdb:
      database: app
      owner: app
  storage:
    size: 5Gi
    storageClass: civo-volume
  resources:
    requests:
      cpu: "100m"
      memory: 512Mi
    limits:
      cpu: "500m"
      memory: 1Gi
  postgresql:
    parameters:
      shared_buffers: "64MB"
      max_connections: "80"
